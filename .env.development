# 开发环境配置
# 检查间隔较短以便快速测试
CHECK_INTERVAL_SECS=10

# 失败阈值较低以便快速发现问题
FAILURE_THRESHOLD=2

# 开发期间可能不需要恢复通知
RECOVERY_NOTIFICATION=true

# 开发环境的飞书机器人配置
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/development-webhook-url

# 开发环境的机器人密钥
FEISHU_BOT_SECRET=your-dev-bot-secret

# 开发团队成员
FEISHU_USER_IDS=ou_dev111111,ou_dev222222