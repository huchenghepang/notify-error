# URL 监控工具环境变量配置示例

# 检查间隔（秒）
# 默认值: 30
# 说明: 每隔多少秒检查一次URL状态
CHECK_INTERVAL_SECS=30

# 失败阈值
# 默认值: 1
# 说明: 连续失败多少次后发送通知（防止短暂波动）
FAILURE_THRESHOLD=3

# 是否发送恢复通知
# 默认值: true
# 说明: 服务恢复时是否发送通知
RECOVERY_NOTIFICATION=true

# 飞书机器人 webhook URL
# 必须配置
# 说明: 飞书机器人的webhook地址，用于发送通知
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-url-here

# 飞书机器人密钥
# 可选配置
# 说明: 如果飞书机器人启用了安全验证，需要配置此密钥
FEISHU_BOT_SECRET=your-bot-secret-here

# 需要提及的用户ID
# 可选配置
# 说明: 需要在通知中提及的用户ID，多个用户用逗号分隔
# 示例: FEISHU_USER_IDS=ou_xxxxxxxxx,ou_yyyyyyyyy
FEISHU_USER_IDS=