# ============================================
# URL Monitor 部署配置文件
# ============================================

# ==================== 服务器配置 ====================
# 服务器 SSH 登录用户名
SERVER_USER=root

# 服务器 IP 或域名（必填）
SERVER_HOST=192.168.1.100

# SSH 端口（默认 22）
SERVER_PORT=22

# ==================== Docker 镜像配置 ====================
# 是否跳过构建（使用现有镜像）
SKIP_BUILD=false

# 镜像标签（默认: latest）
IMAGE_TAG=latest

# 镜像来源: local（本地）或 registry（仓库）
IMAGE_SOURCE=local

# 镜像仓库地址（当 IMAGE_SOURCE=registry 时需要）
REGISTRY_URL=myregistry.com/url-monitor

# ==================== 部署路径配置 ====================
# 测试环境部署路径
TEST_PATH=/var/www/url-monitor

# 预发布环境部署路径
STAGING_PATH=/var/www/url-monitor-staging

# 生产环境部署路径
PRODUCTION_PATH=/var/www/url-monitor

# ==================== 健康检查配置 ====================
# 是否启用健康检查（true/false）
HEALTH_CHECK_ENABLED=true

# 健康检查 URL
HEALTH_CHECK_URL=http://localhost:8483/health

# 健康检查期望的状态码
HEALTH_CHECK_EXPECTED_STATUS=200

# 健康检查最大尝试次数
HEALTH_CHECK_ATTEMPTS=30

# 健康检查间隔时间（秒）
HEALTH_CHECK_INTERVAL=5

# 健康检查超时时间（秒）
HEALTH_CHECK_TIMEOUT=5

# 健康检查失败后的行为: fail（中断部署）, warn（仅警告）, skip（跳过）
HEALTH_CHECK_FAIL_ACTION=warn

# ==================== 备份配置 ====================
# 本地备份目录
BACKUP_DIR=./backups

# 保留备份数量
KEEP_BACKUPS=10

# ==================== 日志配置 ====================
# 日志目录
LOG_DIR=./logs/deploy

# 日志级别: DEBUG, INFO, ERROR
LOG_LEVEL=INFO

# 是否只输出到文件（不输出到控制台）
NO_CONSOLE=false