# 生产环境配置
# 检查间隔设为较长时间以减少请求频率
CHECK_INTERVAL_SECS=60

# 失败阈值设为较高值以避免误报
FAILURE_THRESHOLD=5

# 启用恢复通知
RECOVERY_NOTIFICATION=true

# 生产环境的飞书机器人配置
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/production-webhook-url

# 生产环境的机器人密钥
FEISHU_BOT_SECRET=your-production-bot-secret

# 生产环境需要通知的相关人员
FEISHU_USER_IDS=ou_xxxxxxxxx,ou_yyyyyyyyy,ou_zzzzzzzzz